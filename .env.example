# doxa-global environment

# Its own PostgreSQL database (counts + sessions only)
DATABASE_URL=postgresql://user:pass@localhost:5432/doxa_global

# campaigns-sever (pray.doxa.life) — read endpoints + stats ingest
NUXT_PRAY_BASE_URL=http://localhost:3000
FORM_API_KEY=shared-form-api-key

# Public
NUXT_PUBLIC_SITE_URL=http://localhost:4000
NUXT_PUBLIC_STATINATOR_ENABLED=false

# Mapbox public token for the prayer-coverage map (pk.…)
NUXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
